APP_ENV=development
PORT=4311
FRONTEND_ORIGIN=http://127.0.0.1:4310
FAKE_MODE=true
PAID_DEMO_ENABLED=false
OPENAI_API_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GRANT_SIGNING_SECRET=
# Sandbox checkout uses fixed Retailor storage; a blank key leaves it unavailable.
STRIPE_API_KEY=
# Optional standalone Shopify test-store app. Blank values leave Connect unavailable.
# Configure the callback as FRONTEND_ORIGIN/api/retailor/v1/shopify/callback.
# Keep all credentials server-only; use a separate 32-byte hex encryption key.
# Public Client ID/provider/storage settings are in src/config/shopify-app.ts.
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ENCRYPTION_KEY=

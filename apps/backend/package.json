    "express": "5.3.0",
    "google-auth-library": "11.3.0",
    "openai": "7.32.0",
    "sharp": "0.35.5",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "tsx": "4.23.15"

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.mjs",
    "apps/**/*.test.ts",
    "apps/backend/test/**/*.ts",
    "packages/**/*.test.ts",
    "vitest.config.ts"
  ]
}
